FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/tools/task-scheduler
WORKDIR /app
RUN useradd --uid 10001 --create-home iases && mkdir /data && chown iases /data
COPY src/task-evolver/ /app/tools/task-scheduler/
COPY src/model-router/gateway/ /app/tools/semantic-router/
COPY deploy/render_router.py /app/render_router.py
USER iases
